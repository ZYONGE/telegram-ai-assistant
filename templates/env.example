# 이 파일을 private/.env로 복사한 뒤 값을 채운다. private/ 폴더는 git에 올라가지 않는다.

# BotFather에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=
# 본인 텔레그램 사용자 ID (숫자). 이 ID 외의 사용자는 무시한다.
TELEGRAM_ALLOWED_USER_ID=

# Gemini API 키 ([llm.gemini] backend = "api_key")
# 목표는 Cloud 결제 계정을 연결한 프로젝트의 키다. 무료 티어 키를 쓰려면
# config.toml에서 allow_free_tier = true로 두어야 한다 (입력 내용이 제품 개선에 쓰일 수 있음).
GEMINI_API_KEY=

# Vertex AI 서비스 계정 키 파일 경로 ([llm.gemini] backend = "vertex"일 때만)
# 키 파일도 private/ 안에 둔다.
# GOOGLE_APPLICATION_CREDENTIALS=
