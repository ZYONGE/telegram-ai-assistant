# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 git에 올라가지 않는다.

# BotFather에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=
# 본인 텔레그램 사용자 ID (숫자). 이 ID 외의 사용자는 무시한다.
TELEGRAM_ALLOWED_USER_ID=

# Gemini API 키 ([llm.gemini] backend = "api_key")
# Cloud 결제 계정을 연결한 Google Cloud 프로젝트에서 발급한 키만 쓴다 (무료 티어 키 사용 금지)
GEMINI_API_KEY=

# Vertex AI 서비스 계정 키 파일 경로 ([llm.gemini] backend = "vertex"일 때만)
# GOOGLE_APPLICATION_CREDENTIALS=
